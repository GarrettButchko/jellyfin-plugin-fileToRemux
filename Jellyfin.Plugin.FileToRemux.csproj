<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Jellyfin.Plugin.FileToRemux</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.FileToRemux</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Garrett Butchko</Authors>
    <Company>FileToRemux</Company>
    <Description>Direct high-speed remux streaming and auto-organization plugin for Jellyfin.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.9.11" IncludeAssets="compile" />
    <PackageReference Include="Jellyfin.Model" Version="10.9.11" IncludeAssets="compile" />
  </ItemGroup>

</Project>
